      "css": ".ds-approved{font-family:'Manrope Variable',sans-serif;cursor:pointer;transition:background .16s,color .16s,border-color .16s;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:var(--radius,7px);padding:10px 14px;font-size:11px;font-weight:700;min-height:36px;background:#e1ead4;color:#48622f}.ds-approved:focus-visible{outline:2px solid var(--focus,#d76c46);outline-offset:3px}.ds-approved:disabled{opacity:.45;cursor:not-allowed}"
